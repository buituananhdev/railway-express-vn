@model Common.Contracts.Events.ETicketEvent

<!doctype html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>E-Ticket Đường Sắt Việt Nam</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
            padding: 20px;
        }

        .ticket-container {
            max-width: 800px;
            margin: 0 auto;
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        }

        .header {
            background: #16a34a;
            color: white;
            padding: 25px;
            text-align: center;
        }

        .logo {
            height: 45px;
            margin-bottom: 10px;
            background: rgba(255, 255, 255, 0.2);
            padding: 5px 15px;
            border-radius: 5px;
        }

        .header h1 {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .header .subtitle {
            font-size: 14px;
            opacity: 0.9;
        }

        .ticket-body {
            padding: 30px;
        }

        .ticket-number {
            background: #f0fdf4;
            padding: 15px;
            border-radius: 8px;
            border-left: 4px solid #16a34a;
            margin-bottom: 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .ticket-number .label {
                color: #666;
                font-size: 14px;
            }

            .ticket-number .value {
                font-family: monospace;
                font-size: 16px;
                font-weight: bold;
                color: #16a34a;
            }

        .section {
            margin-bottom: 10px;
            background: #fafafa;
            border-radius: 10px;
            padding: 20px;
            border: 1px solid #e5e5e5;
        }

        .section-title {
            font-size: 16px;
            font-weight: bold;
            color: #333;
            margin-bottom: 15px;
            padding-bottom: 8px;
            border-bottom: 2px solid #16a34a;
            display: inline-block;
        }

        .passenger-name {
            font-size: 18px;
            font-weight: bold;
            color: #333;
            margin-top: 5px;
        }

        .journey-route {
            background: #f0fdf4;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border: 1px solid #bbf7d0;
        }

        .station {
            text-align: center;
            flex: 1;
        }

        .station-label {
            font-size: 12px;
            color: #666;
            margin-bottom: 5px;
            text-transform: uppercase;
        }

        .station-name {
            font-size: 18px;
            font-weight: bold;
            color: #15803d;
        }

        .route-arrow {
            margin: 0 20px;
            font-size: 24px;
            color: #16a34a;
        }

        .datetime-grid {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
        }

        .datetime-card {
            flex: 1;
            padding: 15px;
            border-radius: 8px;
            text-align: center;
        }

        .departure-card {
            background: #fef3c7;
            border: 1px solid #f59e0b;
        }

        .arrival-card {
            background: #dcfce7;
            border: 1px solid #22c55e;
        }

        .datetime-label {
            font-size: 12px;
            font-weight: bold;
            margin-bottom: 5px;
            text-transform: uppercase;
        }

        .departure-card .datetime-label {
            color: #92400e;
        }

        .arrival-card .datetime-label {
            color: #166534;
        }

        .datetime-date {
            font-size: 14px;
            margin-bottom: 5px;
            color: #333;
        }

        .datetime-time {
            font-size: 20px;
            font-weight: bold;
        }

        .departure-card .datetime-time {
            color: #d97706;
        }

        .arrival-card .datetime-time {
            color: #16a34a;
        }

        .train-details {
            display: flex;
            gap: 10px;
        }

        .train-detail {
            flex: 1;
            background: white;
            padding: 15px;
            border-radius: 8px;
            text-align: center;
            border: 2px solid #e5e5e5;
        }

            .train-detail:hover {
                border-color: #16a34a;
            }

        .train-detail-label {
            font-size: 11px;
            color: #666;
            margin-bottom: 5px;
            text-transform: uppercase;
        }

        .train-detail-value {
            font-size: 18px;
            font-weight: bold;
            color: #333;
        }

        .verification-section {
            background: #f0fdf4;
            padding: 25px;
            border-radius: 10px;
            margin-top: 10px;
            display: flex;
            gap: 25px;
            align-items: flex-start;
            border: 1px solid #bbf7d0;
        }

        .qr-container {
            text-align: center;
            flex-shrink: 0;
        }

        .qr-code {
            width: 100px;
            height: 100px;
            background: white;
            padding: 8px;
            border-radius: 8px;
            border: 2px dashed #16a34a;
            margin-bottom: 8px;
        }

        .qr-label {
            font-size: 12px;
            color: #15803d;
            font-weight: bold;
        }

        .instructions {
            flex: 1;
        }

        .instructions-title {
            font-size: 16px;
            font-weight: bold;
            color: #15803d;
            margin-bottom: 12px;
        }

        .instruction-item {
            margin-bottom: 8px;
            font-size: 14px;
            color: #374151;
            padding-left: 15px;
            position: relative;
        }

            .instruction-item:before {
                content: "•";
                color: #16a34a;
                font-weight: bold;
                position: absolute;
                left: 0;
            }

        .footer {
            background: #f9fafb;
            padding: 20px;
            text-align: center;
            border-top: 1px solid #e5e5e5;
        }

        .footer-title {
            font-size: 16px;
            font-weight: bold;
            color: #16a34a;
            margin-bottom: 10px;
        }

        .footer-contacts {
            font-size: 13px;
            color: #666;
            margin-bottom: 10px;
        }

        .footer-note {
            font-size: 12px;
            color: #999;
            font-style: italic;
        }

        /* Highlight accents */
        .accent-yellow {
            background: #fef3c7;
            color: #92400e;
            padding: 2px 8px;
            border-radius: 4px;
            font-weight: bold;
        }

        .accent-green {
            background: #dcfce7;
            color: #166534;
            padding: 2px 8px;
            border-radius: 4px;
            font-weight: bold;
        }

        body
        {
            background: white;
            padding: 0;
        }

        .ticket-container {
            box-shadow: none;
            border-radius: 0;
        }

    </style>
</head>
<body>
    <div class="ticket-container">
        <div class="header">
            <img src="@Model.LogoUrl" alt="Logo Đường Sắt" class="logo" />
            <h1>E-TICKET</h1>
            <div class="subtitle">ĐƯỜNG SẮT VIỆT NAM</div>
        </div>

        <div class="ticket-body">
            <div class="ticket-number">
                <span class="label">Mã vé / Ticket No.</span>
                <span class="value">@Model.TicketNumber</span>
            </div>

            <div class="section">
                <div class="section-title">👤 Thông tin hành khách</div>
                <div>
                    <div style="color: #666; font-size: 13px; margin-bottom: 5px;">Họ và tên / Full Name</div>
                    <div class="passenger-name">@Model.PassengerName</div>
                </div>
            </div>

            <div class="section">
                <div class="section-title">🚂 Thông tin chuyến đi</div>

                <div class="journey-route">
                    <div class="station">
                        <div class="station-label">Ga đi</div>
                        <div class="station-name">@Model.Journey.DepartureStation</div>
                    </div>
                    <div class="route-arrow">🚄</div>
                    <div class="station">
                        <div class="station-label">Ga đến</div>
                        <div class="station-name">@Model.Journey.ArrivalStation</div>
                    </div>
                </div>

                <div class="datetime-grid">
                    <div class="datetime-card departure-card">
                        <div class="datetime-label">⏰ Khởi hành</div>
                        <div class="datetime-date">@Model.Journey.DepartureDate.ToString("dd/MM/yyyy")</div>
                        <div class="datetime-time">@Model.Journey.DepartureTime.ToString(@"hh\:mm")</div>
                    </div>
                    <div class="datetime-card arrival-card">
                        <div class="datetime-label">🏁 Đến nơi</div>
                        <div class="datetime-date">@Model.Journey.ArrivalDate.ToString("dd/MM/yyyy")</div>
                        <div class="datetime-time">
                            @Model.Journey.ArrivalTime.ToString(@"hh\:mm")
                            @if (Model.Journey.DepartureDate.Date != Model.Journey.ArrivalDate.Date)
                            {
                                <span style="font-size: 12px; opacity: 0.7;">(+1)</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="train-details">
                    <div class="train-detail">
                        <div class="train-detail-label">🚂 Số tàu</div>
                        <div class="train-detail-value">@Model.Journey.TrainNumber</div>
                    </div>
                    <div class="train-detail">
                        <div class="train-detail-label">🚃 Toa số</div>
                        <div class="train-detail-value">@Model.Journey.CarriageNumber</div>
                    </div>
                    <div class="train-detail">
                        <div class="train-detail-label">💺 Ghế số</div>
                        <div class="train-detail-value">@Model.Journey.SeatNumber</div>
                    </div>
                </div>
            </div>

            <div class="verification-section">
                <div class="qr-container">
                    <img src="@Model.QrCodeUrl" alt="QR Code" class="qr-code" />
                    <div class="qr-label">Quét mã xác thực</div>
                </div>

                <div class="instructions">
                    <div class="instructions-title">⚠️ Lưu ý quan trọng</div>
                    <div class="instruction-item">
                        Vui lòng có mặt tại ga trước giờ khởi hành ít nhất <span class="accent-yellow">30 phút</span>
                    </div>
                    <div class="instruction-item">
                        Mang theo <span class="accent-green">CMND/CCCD</span> để đối chiếu khi lên tàu
                    </div>
                    <div class="instruction-item">
                        Xuất trình <span class="accent-green">Vé điện tử</span> này hoặc mã vé khi được yêu cầu
                    </div>
                    <div class="instruction-item">
                        Mọi thắc mắc vui lòng liên hệ hotline: <span class="accent-yellow">1900 0000</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="footer">
            <div class="footer-title">🌿 ĐƯỜNG SẮT VIỆT NAM 🌿</div>
            <div class="footer-contacts">
                🌐 duongsatvietnam.vn | 📞 1900 0000 | ✉️ support@duongsatvietnam.vn
            </div>
            <div class="footer-note">
                Cảm ơn quý khách đã sử dụng dịch vụ của chúng tôi!
            </div>
        </div>
    </div>
</body>
</html>
